{
    "name": "sideka/sideka-ng",
    "description": "Web Pengajuan Domain dan Pengelolaan Data SIDeKa-NG Kabupaten Bandung Barat",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
